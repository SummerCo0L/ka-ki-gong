# Local Setup Configuration

# Bot Configuration for bot.py
# Copy this to .env (or merge with your existing .env) before running the bot.

# ── OpenRouter LLM ────────────────────────────────────────────────────────────

OPENROUTER_API_KEY=

# Required. API key for OpenRouter (https://openrouter.ai).

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter's OpenAI-compatible base URL.
# The client appends /chat/completions automatically — do NOT include it here.

OPENROUTER_MODEL=openai/gpt-oss-120b
# Model identifier sent in the request.

OPENROUTER_TEMPERATURE=0.6
# Sampling temperature (0.0 = deterministic, 2.0 = very random).
# Leave commented to use the provider default.

OPENROUTER_TOP_P=0.9
# Nucleus sampling threshold.
# Leave commented to use the provider default.

OPENROUTER_MAX_TOKENS=512
# Maximum tokens the LLM is allowed to generate per turn.

OPENROUTER_PRESENCE_PENALTY=0.1

OPENROUTER_FREQUENCY_PENALTY=0.1

OPENROUTER_REASONING_EFFORT=low
# Forwarded as {"reasoning": {"effort": ...}}. Defaults to "low" in code even if
# unset/commented out here — this is a latency-sensitive voice task, and
# gpt-oss-120b's provider-default effort (often "medium") can add 30-45s of
# thinking time per turn. Set to "none" to disable reasoning entirely, or
# "medium"/"high" if you need better answers and can tolerate the latency.

# OPENROUTER_SYSTEM_PROMPT=You are a concise voice assistant.
# Optional inline system prompt.
# Ignored when OPENROUTER_SYSTEM_PROMPT_FILE is set.

OPENROUTER_SYSTEM_PROMPT_FILE=prompt/PROMPT_TEMPLATE_senior_support_grounded_answer.md
# Load the system prompt from a file (Markdown or plain text).
# Relative paths are resolved from the project root folder.
# Available templates:
#   prompt/PROMPT_TEMPLATE_senior_support_grounded_answer.md — the Ka-Ki-Gong
#     grounded-answer assistant; pairs with the <retrieved_evidence> block that
#     bots/bot.py injects before every turn.
#   prompt/PROMPT_TEMPLATE_v5_fewshots.md   — unrelated leftover quickstart demo
#     (presentation Q&A practice bot) + 10 worked examples.
#   prompt/PROMPT_TEMPLATE_v5_slim.md       — same demo persona, rules only, no few-shot examples.

# ── Local Retrieval (knowledge_base/) ────────────────────────────────────────

# OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Embedding model used both offline (scripts/build_index.py) and at query time.

# OPENROUTER_EMBED_QUERY_PREFIX=
# OPENROUTER_EMBED_PASSAGE_PREFIX=
# Optional text prefixes prepended before embedding (e.g. e5-style "query: "/
# "passage: "). Leave unset for nvidia/nemotron-3-embed-1b unless evaluation
# shows explicit prefixes improve retrieval quality.

KNOWLEDGE_BASE_DIR=knowledge_base
# Source folder scanned by scripts/build_index.py.

RETRIEVAL_DATA_DIR=data
# Where scripts/build_index.py saves embeddings.npy/schemes.json/manifest.json,
# and where bots/bot.py loads them from at startup.

RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.5
RETRIEVAL_HYBRID_ALPHA=0.7
# hybrid_score = alpha * dense_cosine_similarity + (1 - alpha) * lexical_score

RERANKER_MODEL=cohere/rerank-4-fast
# Optional cross-encoder second stage: fetches RERANK_CANDIDATES hybrid results,
# reranks them, and keeps the top RETRIEVAL_TOP_K for the evidence block. Leave
# blank/unset to skip reranking and use plain hybrid ranking (previous default).
# Falls back to hybrid ranking (not to no evidence) if a rerank call fails, since
# :free-tier reranker availability/rate limits are less reliable than embeddings.

RERANK_CANDIDATES=10
# Number of hybrid-search candidates fetched per turn before reranking. Ignored
# when RERANKER_MODEL is unset.

ENABLE_SSO_LOOKUP_TOOL=true
# Optional `find_nearest_sso` tool call (processors/sso_tool.py), letting
# gpt-oss-120b look up the Social Service Office nearest an area the user
# names. On by default since it's a core feature; subject to the same
# OpenRouter/gpt-oss-120b streaming-tool-call caveat as above — set to false
# if find_nearest_sso calls fail to stream correctly.

SSO_LOCATIONS_FILE=knowledge_base/social_service_offices/sso_locations.json
# Structured SSO contact data (retrieval/sso_lookup.py). Not scanned by
# scripts/build_index.py — matched by area name, not embeddings.

# ── MERaLiON Speech Translation ────────────────────────────────────────────────

MERALION_API_KEY=
# Required. API key for the MERaLiON speech-translation endpoint.

MERALION_API_BASE_URL=https://api.meralion.ai
# MERaLiON API base URL.

MERALION_TRANSLATION_MODEL=MERaLiON/MERaLiON-3-3B-ASR-CTM
# Model used to translate Hokkien (or other supported languages) speech into English text.

# ── MERaLiON-3-10B Singapore Chinese Renderer ─────────────────────────────────

ENABLE_CHINESE_RENDERER=true
# Narrow transformation only: verified grounded English answer -> Singapore
# Chinese. Runs on the
# complete buffered LLM response before it reaches the TTS model.
# Set to false to send the grounded English answer directly to TTS instead
# (previous default behavior).

MERALION_RENDER_MODEL=MERaLiON/MERaLiON-3-10B
# Uses the same MERALION_API_KEY / MERALION_API_BASE_URL as speech translation.

MERALION_RENDER_PROMPT_FILE=prompt/english_to_singapore-chinese.md
# Renderer prompt template with a {{answer_en}} placeholder.

MERALION_RENDER_TEMPERATURE=0.2
# Kept low: this is a narrow rendering task, not creative generation.

# ── OpenRouter TTS ────────────────────────────────────────────────────────────

# OPENROUTER_TTS_API_KEY=
# Optional override; defaults to OPENROUTER_API_KEY.

# OPENROUTER_TTS_BASE_URL=
# Optional override; defaults to OPENROUTER_BASE_URL.

OPENROUTER_TTS_MODEL=qwen/qwen-audio-3.0-tts-flash
# Text-to-speech model. Note: this model's system voices only cover Mandarin
# Chinese and English — there is no Hokkien/Minnan voice or dialect parameter,
# so Hokkien Hanji text will be read aloud with Mandarin pronunciation.
# See services/openrouter_tts.py.

OPENROUTER_TTS_VOICE=loongjohn
# Other option: longanhuan_v3.6.

OPENROUTER_TTS_PCM_SAMPLE_RATE=24000
# Sample rate of the raw PCM DashScope returns (undocumented by OpenRouter;
# matches DashScope's own Qwen-Audio-TTS quickstart default). Adjust if audio
# sounds pitch-shifted/sped up.

# Turn detection tuning
VAD_STOP_SECS=3
# Silence duration before VAD considers the user stopped speaking.
# Set to 5.0s so natural presentation pauses don't prematurely end a turn.

USER_TURN_STOP_TIMEOUT=10
# Aggregator-level fallback: force-closes the turn if SpeechTimeoutStrategy
# never fires (e.g. STT hangs, VAD misfires). Raised to 15s to accommodate
# long presentation turns.

USER_SPEECH_TIMEOUT=0.5
# Grace period after VAD detects silence before closing the turn.
# Kept short (0.5s) because VAD_STOP_SECS=5.0 already confirms the user is
# done — no need for additional wait. Total silence before turn closes: ~5.5s.